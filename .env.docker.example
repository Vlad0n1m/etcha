# ============================================
# Docker Compose Environment Configuration
# Copy this file to .env and fill in values
# ============================================

# ============================================
# PostgreSQL Database
# ============================================
POSTGRES_USER=etcha
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=etcha
POSTGRES_PORT=5432

# ============================================
# Application Port
# ============================================
APP_PORT=3000

# ============================================
# Auth.js (NextAuth v5) - REQUIRED
# ============================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=generate_a_secure_secret_here

# Google OAuth (optional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Twitter/X OAuth (optional)
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=

# Legacy (can be same as AUTH_SECRET)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_a_secure_secret_here

# ============================================
# JWT - REQUIRED
# ============================================
# Generate with: openssl rand -base64 32
JWT_SECRET=generate_a_secure_jwt_secret_here

# ============================================
# Solana Configuration
# ============================================
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Platform wallet private key (JSON array format)
# Generate a new keypair with: solana-keygen new
PLATFORM_WALLET_PRIVATE_KEY=[]
SOLANA_PRIVATE_KEY=[]

# ============================================
# Application URLs
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Salt for wallet derivation
DERIVATION_SALT=etcha-platform-salt

# ============================================
# Cloudinary (for image uploads)
# ============================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================================
# cNFT (Compressed NFT) Configuration
# ============================================
ENABLE_CNFT=true
DEFAULT_NFT_TYPE=cnft

# DAS API URL for cNFT operations
# Use Helius, Triton, or other DAS-compatible RPC
HELIUS_RPC_URL=
DAS_API_URL=
