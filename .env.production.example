# ============================================
# PRODUCTION Environment Configuration
# For deployment on etcha.app
# ============================================

# ============================================
# PostgreSQL Database
# ============================================
POSTGRES_USER=etcha
POSTGRES_PASSWORD=GENERATE_STRONG_PASSWORD_HERE
POSTGRES_DB=etcha

# ============================================
# Auth.js (NextAuth v5) - REQUIRED
# ============================================
# Generate with: openssl rand -base64 32
AUTH_SECRET=GENERATE_WITH_openssl_rand_-base64_32

# Google OAuth (optional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Twitter/X OAuth (optional)
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=

# Legacy (same as AUTH_SECRET)
NEXTAUTH_URL=https://etcha.app
NEXTAUTH_SECRET=SAME_AS_AUTH_SECRET

# ============================================
# JWT - REQUIRED
# ============================================
# Generate with: openssl rand -base64 32
JWT_SECRET=GENERATE_WITH_openssl_rand_-base64_32

# ============================================
# Solana Configuration
# ============================================
# For production use mainnet-beta
SOLANA_NETWORK=mainnet-beta
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Platform wallet private key (JSON array format)
# CRITICAL: Keep this secret! Generate with: solana-keygen new
PLATFORM_WALLET_PRIVATE_KEY=[]
SOLANA_PRIVATE_KEY=[]

# ============================================
# Application URLs
# ============================================
NEXT_PUBLIC_APP_URL=https://etcha.app

# Salt for wallet derivation (keep consistent!)
DERIVATION_SALT=etcha-platform-salt-CHANGE_ME

# ============================================
# Cloudinary (for image uploads) - REQUIRED
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# cNFT (Compressed NFT) Configuration
# ============================================
ENABLE_CNFT=true
DEFAULT_NFT_TYPE=cnft

# DAS API URL for cNFT operations (REQUIRED for mainnet)
# Use Helius, Triton, or other DAS-compatible RPC
# Get API key from https://helius.dev/
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
DAS_API_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# ============================================
# SSL Configuration (Let's Encrypt)
# ============================================
SSL_EMAIL=admin@etcha.app
SSL_STAGING=0
